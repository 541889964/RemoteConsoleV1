<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView android:text="Remote Slave V1"
            android:textSize="24sp" android:textStyle="bold"
            android:textColor="#F0F2F8" android:layout_marginTop="40dp"/>
        <TextView android:text="Universal · Android 5.0+"
            android:textSize="12sp" android:textColor="#6B7AA8"
            android:layout_marginTop="4dp" android:layout_marginBottom="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="#131A2E" app:cardCornerRadius="20dp"
            app:cardElevation="0dp" android:layout_marginBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:text="运行状态"
                    android:textSize="12sp" android:textColor="#6B7AA8"/>
                <TextView android:id="@+id/tvStatus"
                    android:text="加载中..."
                    android:textSize="13sp" android:textColor="#F0F2F8"
                    android:lineSpacingExtra="6dp" android:layout_marginTop="12dp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:id="@+id/btnAccessibility"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"
            app:cardBackgroundColor="#131A2E" app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="20dp" android:gravity="center_vertical">
                <TextView android:text="🔧" android:textSize="24sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                    <TextView android:text="无障碍服务" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="#F0F2F8"/>
                    <TextView android:text="必需 · 用于手势注入" android:textSize="11sp"
                        android:textColor="#6B7AA8" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:text="›" android:textSize="24sp" android:textColor="#4A6BFF"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:id="@+id/btnBattery"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"
            app:cardBackgroundColor="#131A2E" app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="20dp" android:gravity="center_vertical">
                <TextView android:text="🔋" android:textSize="24sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                    <TextView android:text="电池优化" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="#F0F2F8"/>
                    <TextView android:text="推荐 · 提高存活率" android:textSize="11sp"
                        android:textColor="#6B7AA8" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:text="›" android:textSize="24sp" android:textColor="#7A5BFF"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:id="@+id/btnStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:clickable="true" android:focusable="true"
            app:cardBackgroundColor="#131A2E" app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="20dp" android:gravity="center_vertical">
                <TextView android:text="🔄" android:textSize="24sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                    <TextView android:text="刷新状态" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="#F0F2F8"/>
                    <TextView android:text="重新检查权限" android:textSize="11sp"
                        android:textColor="#6B7AA8" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:text="›" android:textSize="24sp" android:textColor="#3DD68C"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
