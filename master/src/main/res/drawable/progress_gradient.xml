<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#00000000"/><corners android:radius="2dp"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape>
            <gradient android:startColor="#4A6BFF" android:centerColor="#7A5BFF" android:endColor="#E94560"/>
            <corners android:radius="2dp"/>
        </shape></clip>
    </item>
</layer-list>
